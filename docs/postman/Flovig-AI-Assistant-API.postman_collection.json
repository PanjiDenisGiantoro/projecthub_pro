{
  "info": {
    "name": "Flovig — AI Assistant (Runa) API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "AI Assistant untuk mobile. Jalankan **Auth › Login** dulu. Detail: docs/API_AI_ASSISTANT_MOBILE.md.\n\n`/ai/chat` membalas `text/plain` (streaming) untuk jawaban biasa, atau JSON `{reply, action}` untuk usulan aksi. Postman menampilkan stream setelah selesai."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://flovig.com/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": "user@example.com"
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login & simpan token ke variable `token`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AI Assistant",
      "item": [
        {
          "name": "Chat — tanya biasa (streaming text)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ai/chat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ai",
                "chat"
              ]
            },
            "description": "Balasan `text/plain` chunked.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Cara mengajukan cuti gimana?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Chat — minta buat proyek (JSON action)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ai/chat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ai",
                "chat"
              ]
            },
            "description": "Bisa membalas JSON `{reply:'', action:{tool,label,args}}`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Buatkan proyek baru bernama Aplikasi Kasir\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Execute — create_project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ai/execute-action",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ai",
                "execute-action"
              ]
            },
            "description": "Jalankan setelah user konfirmasi. Butuh permission `create project`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool\": \"create_project\",\n  \"args\": {\n    \"name\": \"Aplikasi Kasir\",\n    \"description\": \"\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Execute — create_task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ai/execute-action",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ai",
                "execute-action"
              ]
            },
            "description": "Proyek dicari by nama (harus tepat 1 yang cocok & bisa diakses user).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool\": \"create_task\",\n  \"args\": {\n    \"project_name\": \"Aplikasi Kasir\",\n    \"title\": \"Desain login\",\n    \"description\": \"\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}